{
  "name": "grandeprairie.dev",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild-seo.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2024-12-01 --persist-to .wrangler/state",
    "pages:deploy": "wrangler pages deploy dist --project-name=grandeprairie-dev",
    "db:migrate": "wrangler d1 execute grandeprairie-dev-db --file=db/schema.sql --remote",
    "db:migrate:local": "wrangler d1 execute grandeprairie-dev-db --file=db/schema.sql --local",
    "db:seed": "wrangler d1 execute grandeprairie-dev-db --file=db/seed.sql --remote",
    "db:seed:local": "wrangler d1 execute grandeprairie-dev-db --file=db/seed.sql --local"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.64.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^2.6.0",
    "wouter": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250313.0",
    "@eslint/js": "^9.39.4",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
